# =============================================================================
# /etc/default/grub — KAAL OS GRUB2 Configuration
# =============================================================================
# This is the main GRUB2 configuration file. It is read by grub2-mkconfig
# to generate /boot/grub2/grub.cfg (BIOS) or /boot/efi/EFI/kaal/grub.cfg (UEFI).
#
# Custom drop-in configs live in /etc/default/grub.d/ and are sourced
# automatically by grub2-mkconfig.
# =============================================================================

# ---- Bootloader Identity ----
# Distro name shown in GRUB menu title and UEFI boot entry
GRUB_DISTRIBUTOR="KAAL OS"

# ---- Timeout ----
# 5 seconds to choose, then boot default. Set to 0 to skip menu entirely
# (hold Shift during boot to force-show the menu).
GRUB_TIMEOUT=5
GRUB_TIMEOUT_STYLE=menu

# ---- Default Entry ----
# Boot the first/saved entry by default. Use "saved" to remember last choice.
GRUB_DEFAULT=saved
GRUB_SAVEDEFAULT=true

# ---- Kernel Command Line ----
# Base parameters applied to ALL boot entries. GPU-specific parameters are
# added dynamically by /etc/grub.d/06-distro-gpu-params based on detected hardware.
#
# Parameters breakdown:
#   resume=UUID=...       — Resume from hibernate using swap partition/file
#                           (auto-populated by installer via /etc/default/grub.d/resume.conf)
#   rd.driver.pre=...     — Pre-load amdgpu/nvidia in initramfs
#   nvidia-drm.modeset=1  — Enable NVIDIA Wayland modesetting (required for Wayland on NVIDIA)
#   nvme_load=yes         — Ensure NVMe driver loads early
#   loglevel=3            — Kernel log verbosity (0=silent, 7=debug, 3=warnings+errors)
#   systemd.show_status=0 — Hide systemd boot messages (cleaner boot)
#   vt.global_cursor_default=0 — Hide cursor blinking during boot (for Plymouth)
#   amdgpu.ppfeaturemask=0xffffffff — Enable AMD power play controls (overclocking/fan control)
#
GRUB_CMDLINE_LINUX="loglevel=3 systemd.show_status=0 vt.global_cursor_default=0 nvme_load=yes"

# ---- Graphics / Display ----
# Use graphical terminal in GRUB (supports themes, background images)
GRUB_TERMINAL_OUTPUT="gfxterm"

# Resolution for GRUB graphical terminal. Matches common display defaults.
# GRUB will fall back to text if this resolution isn't supported.
GRUB_GFXMODE="auto"
GRUB_GFXPAYLOAD_LINUX="keep"

# ---- Theme ----
# Theme will be configured later. For now, use no theme (text-only fallback).
# When the distro theme is designed, set:
#   GRUB_THEME="/boot/grub2/themes/kaal/theme.txt"
GRUB_THEME=""

# ---- Background ----
# Optional background image (1280x800 or matching GRUB_GFXMODE resolution).
# Will be set with the distro theme.
GRUB_BACKGROUND=""

# ---- Font ----
# Custom font for GRUB menu (PF2 format). DejaVu Sans is a safe default.
# Generated by: grub2-mkfont -s 16 -o /boot/grub2/fonts/unicode.pf2 /usr/share/fonts/dejavu/DejaVuSans.ttf
GRUB_FONT="/boot/grub2/fonts/unicode.pf2"

# ---- Disable Submenu ----
# Flatten the menu — don't hide kernels under an "Advanced" submenu.
# Makes it easier to select older kernels for rollback.
GRUB_DISABLE_SUBMENU=true

# ---- Recovery ----
# Show recovery entries (boot to single-user / rescue mode)
GRUB_DISABLE_RECOVERY=false

# ---- OS Prober ----
# Detect other operating systems (Windows dual-boot, other Linux installs)
# Disabled by default for security — enable if dual-booting
GRUB_DISABLE_OS_PROBER=true

# ---- Hidden Menu ----
# If true, hide menu and only show on Shift key press. We want it visible.
GRUB_DISABLE_TIMEOUT=false

# ---- UUID-based Boot ----
# Use UUIDs instead of device names (sda1, nvme0n1p1) for stable booting
GRUB_DISABLE_LINUX_UUID=false
GRUB_DISABLE_LINUX_PARTUUID=false

# ---- Recovery Partition ----
# If a recovery snapshot/partition exists, add a boot entry for it
GRUB_ENABLE_CRYPTODISK=y

# ---- Btrfs Snapshots in GRUB ----
# Show btrfs snapshots as boot entries (via grub2-btrfs-bootenv)
GRUB_BTRFS_SNAPSHOT_BOOTING=true

# =============================================================================
# Drop-in configuration files in /etc/default/grub.d/ are sourced below.
# These handle GPU-specific params, resume UUID, and installer overrides.
# =============================================================================
