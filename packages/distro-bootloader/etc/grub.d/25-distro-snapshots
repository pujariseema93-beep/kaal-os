#!/bin/bash
# =============================================================================
# /etc/grub.d/25-distro-snapshots — Btrfs Snapshot Boot Entries
# =============================================================================
# Adds btrfs snapshot entries to the GRUB menu so users can boot into
# a pre-update snapshot if an update breaks the system.
#
# Requires: grub2-btrfs-bootenv or snapper-grub
# Depends on: btrfs filesystem with snapper or timeshift snapshots
#
# Snapshots appear under the main kernel entries, clearly labeled with
# date/time and description (e.g. "pre-update 2026-09-08 14:32").
# =============================================================================

set -e

. "${datadir}/grub/grub-mkconfig_lib"

# ---- Check if btrfs snapshot booting is available ----
SNAPSHOT_TOOL=""

if [ -x /usr/bin/snapper ]; then
    SNAPSHOT_TOOL="snapper"
elif [ -x /usr/bin/timeshift ]; then
    SNAPSHOT_TOOL="timeshift"
fi

if [ -z "$SNAPSHOT_TOOL" ]; then
    # No snapshot tool installed — skip silently
    exit 0
fi

# ---- Check if root is on btrfs ----
ROOT_FSTYPE=""
if [ -f /etc/fstab ]; then
    ROOT_FSTYPE=$(awk '/^[^#].*[[:space:]]\/[[:space:]]/ {print $3}' /etc/fstab 2>/dev/null | head -1)
fi

if [ "$ROOT_FSTYPE" != "btrfs" ]; then
    exit 0
fi

# ---- Generate snapshot entries ----
# The actual snapshot entry generation is handled by grub2-snapper-plugin
# or grub2-btrfs-bootenv package. This script provides the integration point
# and ensures the entries are properly separated and styled.

cat <<'SNAPSHOT_EOF'

# --- KAAL OS Btrfs Snapshot Boot Entries ---
# If snapshots exist, they will appear below the main kernel entries.
# Use these to roll back if an update causes issues.

SNAPSHOT_EOF

# List snapper snapshots if available
if [ "$SNAPSHOT_TOOL" = "snapper" ]; then
    SNAPSHOTS=$(snapper -c root list --disable-used-space 2>/dev/null | tail -n +4 || true)
    if [ -n "$SNAPSHOTS" ]; then
        echo "# Snapshots available (snapper):"
        echo "$SNAPSHOTS" >&2
        echo "# (Entries generated by grub2-snapper-plugin)"
    fi
fi

# List timeshift snapshots if available
if [ "$SNAPSHOT_TOOL" = "timeshift" ]; then
    if [ -d /run/timeshift/backup/timeshift-btrfs ]; then
        echo "# Snapshots available (timeshift-btrfs)"
        echo "# (Entries generated by timeshift-grub)"
    fi
fi
