#!/bin/bash
# =============================================================================
# /usr/libexec/distro-bootloader/distro-bootloader-setup
# =============================================================================
# Main bootloader setup script. Called during installation and when the
# user wants to reconfigure or switch bootloaders.
#
# Usage:
#   distro-bootloader-setup --install [grub|systemd-boot] [--esp /boot/efi]
#   distro-bootloader-setup --switch [grub|systemd-boot]
#   distro-bootloader-setup --regenerate
#   distro-bootloader-setup --detect-gpu
#   distro-bootloader-setup --set-param <param> [--remove]
#
# This script:
#   1. Detects the GPU and generates the correct kernel parameters
#   2. Installs GRUB2 or systemd-boot to the ESP
#   3. Generates boot entries (GRUB config or systemd-boot entries)
#   4. Regenerates the initramfs with the correct dracut config
#   5. Creates fallback entries for recovery
# =============================================================================

set -euo pipefail

# ---- Constants ----
DISTRO_NAME="KAAL OS"
DISTRO_DIR="distro"  # Directory on ESP for kernel/initramfs files
ESP_PATH="${ESP_PATH:-/boot/efi}"
GRUB_DIR="/etc/grub.d"
GRUB_DEFAULT="/etc/default/grub"
GRUB_DROPIN_DIR="/etc/default/grub.d"
DRACUT_DROPIN_DIR="/etc/dracut.conf.d"
SD_BOOT_TEMPLATES="/usr/share/distro-bootloader/systemd-boot"
KERNEL_PARAMS_DIR="/usr/share/distro-bootloader/kernel-params"

# ---- Colors for output ----
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

log()    { echo -e "${GREEN}[$DISTRO_NAME bootloader]${NC} $*"; }
warn()   { echo -e "${YELLOW}[$DISTRO_NAME bootloader]${NC} WARNING: $*"; }
error()  { echo -e "${RED}[$DISTRO_NAME bootloader]${NC} ERROR: $*" >&2; }
info()   { echo -e "${BLUE}[$DISTRO_NAME bootloader]${NC} $*"; }

# =============================================================================
# GPU Detection
# =============================================================================
detect_gpu() {
    local gpu_info
    gpu_info=$(lspci -nn 2>/dev/null | grep -iE 'VGA compatible|3D controller|Display controller' || true)

    GPU_NVIDIA=false
    GPU_AMD=false
    GPU_INTEL=false
    GPU_HYBRID=false

    if echo "$gpu_info" | grep -qiE 'NVIDIA|GeForce|Quadro|RTX|GTX'; then
        GPU_NVIDIA=true
    fi

    if echo "$gpu_info" | grep -qiE 'AMD|Radeon|ATI|RDNA'; then
        GPU_AMD=true
    fi

    if echo "$gpu_info" | grep -qiE 'Intel|UHD|Iris|Arc|HD Graphics'; then
        GPU_INTEL=true
    fi

    # Detect hybrid (dual GPU laptops)
    local gpu_count
    gpu_count=$(echo "$gpu_info" | wc -l)
    if [ "$gpu_count" -gt 1 ]; then
        GPU_HYBRID=true
    fi

    # Report
    info "GPU Detection Results:"
    echo "  NVIDIA: $GPU_NVIDIA"
    echo "  AMD:    $GPU_AMD"
    echo "  Intel:  $GPU_INTEL"
    echo "  Hybrid: $GPU_HYBRID"
}

# =============================================================================
# Build Kernel Parameters String
# =============================================================================
build_kernel_params() {
    local params=""

    # Source GPU param definitions
    if [ -f "$GRUB_DROPIN_DIR/10-distro-gpu.conf" ]; then
        . "$GRUB_DROPIN_DIR/10-distro-gpu.conf"
    fi

    # Base params (from /etc/default/grub)
    params="loglevel=3 systemd.show_status=0 vt.global_cursor_default=0 nvme_load=yes"

    # GPU-specific params
    if [ "$GPU_NVIDIA" = "true" ]; then
        params="$params ${DISTRO_NVIDIA_PARAMS:-}"
    fi

    if [ "$GPU_AMD" = "true" ]; then
        params="$params ${DISTRO_AMD_PARAMS:-}"
    fi

    if [ "$GPU_INTEL" = "true" ]; then
        params="$params ${DISTRO_INTEL_PARAMS:-}"
    fi

    # Gaming params
    params="$params ${DISTRO_GAMING_PARAMS:-}"

    # Security params
    params="$params ${DISTRO_SECURITY_PARAMS:-}"

    # Resume params (hibernation)
    if [ -f "$GRUB_DROPIN_DIR/20-distro-resume.conf" ]; then
        . "$GRUB_DROPIN_DIR/20-distro-resume.conf"
        if [ -n "${GRUB_CMDLINE_LINUX_RESUME:-}" ]; then
            params="$params $GRUB_CMDLINE_LINUX_RESUME"
        fi
    fi

    # Clean up whitespace
    KERNEL_PARAMS=$(echo "$params" | sed 's/  */ /g' | sed 's/^ //;s/ $//')

    info "Kernel parameters: $KERNEL_PARAMS"
}

# =============================================================================
# Get root filesystem UUID
# =============================================================================
get_root_uuid() {
    ROOT_UUID=$(findmnt -n -o UUID / 2>/dev/null || true)
    if [ -z "$ROOT_UUID" ]; then
        # Try from blkid
        ROOT_UUID=$(blkid -s UUID -o value "$(findmnt -n -o SOURCE /)" 2>/dev/null || true)
    fi
    if [ -z "$ROOT_UUID" ]; then
        warn "Could not determine root UUID — using placeholder"
        ROOT_UUID="ROOT_UUID_PLACEHOLDER"
    fi
}

# =============================================================================
# Get machine ID
# =============================================================================
get_machine_id() {
    if [ -f /etc/machine-id ]; then
        MACHINE_ID=$(cat /etc/machine-id)
    else
        MACHINE_ID="00000000000000000000000000000000"
    fi
}

# =============================================================================
# Install GRUB2
# =============================================================================
install_grub() {
    local esp="${1:-$ESP_PATH}"

    log "Installing GRUB2 to $esp..."

    # Ensure ESP is mounted
    if ! findmnt "$esp" >/dev/null 2>&1; then
        error "ESP ($esp) is not mounted. Cannot install GRUB."
        exit 1
    fi

    # Install GRUB2 EFI binary
    if [ -d /sys/firmware/efi ]; then
        # UEFI mode
        grub2-install --target=x86_64-efi --efi-directory="$esp" \
            --bootloader-id="$DISTRO_NAME" --recheck
        log "GRUB2 EFI installed to $esp/EFI/$DISTRO_DIR/"
    else
        # BIOS mode (legacy)
        grub2-install "$(findmnt -n -o PKNAME "$(findmnt -n -o SOURCE /)")" --recheck
        log "GRUB2 BIOS installed to MBR"
    fi

    # Generate GRUB config
    regenerate_grub_config
}

# =============================================================================
# Regenerate GRUB2 configuration
# =============================================================================
regenerate_grub_config() {
    log "Regenerating GRUB2 configuration..."

    # Make scripts executable
    chmod +x "$GRUB_DIR"/0*-distro* "$GRUB_DIR"/2*-distro* 2>/dev/null || true

    # Run grub2-mkconfig
    if [ -d /sys/firmware/efi ]; then
        grub2-mkconfig -o "${ESP_PATH}/EFI/${DISTRO_DIR}/grub.cfg"
    else
        grub2-mkconfig -o /boot/grub2/grub.cfg
    fi

    log "GRUB2 configuration regenerated"
}

# =============================================================================
# Install systemd-boot
# =============================================================================
install_systemd_boot() {
    local esp="${1:-$ESP_PATH}"

    log "Installing systemd-boot to $esp..."

    # Ensure ESP is mounted
    if ! findmnt "$esp" >/dev/null 2>&1; then
        error "ESP ($esp) is not mounted. Cannot install systemd-boot."
        exit 1
    fi

    # Install systemd-boot
    bootctl install --esp-path="$esp" 2>/dev/null || {
        # If already installed, update instead
        bootctl update --esp-path="$esp"
    }

    # Install loader.conf
    cp "$SD_BOOT_TEMPLATES/loader.conf" "$esp/loader/loader.conf"
    log "loader.conf installed"

    # Create distro directory on ESP for kernel/initramfs
    mkdir -p "$esp/$DISTRO_DIR"

    # Generate boot entries
    generate_sd_boot_entries "$esp"

    log "systemd-boot installed to $esp"
}

# =============================================================================
# Generate systemd-boot entries
# =============================================================================
generate_sd_boot_entries() {
    local esp="${1:-$ESP_PATH}"
    local entries_dir="$esp/loader/entries"

    mkdir -p "$entries_dir"

    # Get system info
    get_root_uuid
    get_machine_id

    # Get current kernel version
    local kernel_version
    kernel_version=$(uname -r)

    # Copy kernel and initramfs to ESP
    cp "/lib/modules/$kernel_version/vmlinuz" "$esp/$DISTRO_DIR/vmlinuz" 2>/dev/null || \
        cp "/boot/vmlinuz-$kernel_version" "$esp/$DISTRO_DIR/vmlinuz"
    cp "/boot/initramfs-$kernel_version.img" "$esp/$DISTRO_DIR/initramfs.img" 2>/dev/null || \
        warn "initramfs not found for $kernel_version"

    # Generate main entry from template
    local main_entry="$entries_dir/${DISTRO_DIR}.conf"
    sed \
        -e "s/__KERNEL_VERSION__/$kernel_version/g" \
        -e "s/__MACHINE_ID__/$MACHINE_ID/g" \
        -e "s/__DISTRO_DIR__/$DISTRO_DIR/g" \
        -e "s/__ROOT_UUID__/$ROOT_UUID/g" \
        -e "s/__KERNEL_PARAMS__/$KERNEL_PARAMS/g" \
        "$SD_BOOT_TEMPLATES/entry-distro.conf.template" > "$main_entry"
    log "Main boot entry: $main_entry"

    # Generate fallback entry
    local fallback_entry="$entries_dir/${DISTRO_DIR}-fallback.conf"
    sed \
        -e "s/__KERNEL_VERSION__/$kernel_version/g" \
        -e "s/__MACHINE_ID__/$MACHINE_ID/g" \
        -e "s/__DISTRO_DIR__/$DISTRO_DIR/g" \
        -e "s/__ROOT_UUID__/$ROOT_UUID/g" \
        "$SD_BOOT_TEMPLATES/entry-distro-fallback.conf.template" > "$fallback_entry"
    log "Fallback boot entry: $fallback_entry"

    # Also generate a fallback initramfs if it doesn't exist
    if [ ! -f "/boot/initramfs-$kernel_version-fallback.img" ]; then
        info "Generating fallback initramfs (hostonly=no)..."
        dracut --no-hostonly \
            --omit-drivers "nvidia nouveau amdgpu i915" \
            -f "/boot/initramfs-$kernel_version-fallback.img" \
            "$kernel_version" 2>/dev/null || warn "Fallback initramfs generation failed"
        cp "/boot/initramfs-$kernel_version-fallback.img" "$esp/$DISTRO_DIR/initramfs-fallback.img"
    fi
}

# =============================================================================
# Regenerate initramfs
# =============================================================================
regenerate_initramfs() {
    log "Regenerating initramfs with distro dracut config..."

    # Ensure drop-in configs are in place
    if [ ! -f "$DRACUT_DROPIN_DIR/10-distro-gpu.conf" ]; then
        warn "Dracut GPU config not found — initramfs may not include GPU drivers"
    fi

    # Regenerate for all installed kernels
    local kernel_version
    for kernel_dir in /lib/modules/*/; do
        kernel_version=$(basename "$kernel_dir")
        info "Generating initramfs for kernel $kernel_version..."
        dracut --force --kver "$kernel_version" 2>&1 | head -20
    done

    log "Initramfs regeneration complete"
}

# =============================================================================
# Switch bootloader
# =============================================================================
switch_bootloader() {
    local target="${1:-grub}"

    case "$target" in
        grub|grub2)
            log "Switching to GRUB2..."
            # Remove systemd-boot entries
            rm -f "$ESP_PATH/loader/entries/${DISTRO_DIR}"*.conf 2>/dev/null || true
            # Install GRUB
            install_grub "$ESP_PATH"
            # Mark as active
            echo "grub2" > /etc/distro-bootloader/active
            log "Active bootloader: GRUB2"
            ;;
        systemd-boot|sd-boot)
            log "Switching to systemd-boot..."
            # Remove GRUB EFI entry (but don't delete GRUB files)
            efibootmgr -b "$(efibootmgr | grep "$DISTRO_NAME" | awk '{print $1}' | sed 's/Boot//;s/*//')" -B 2>/dev/null || true
            # Install systemd-boot
            install_systemd_boot "$ESP_PATH"
            # Mark as active
            echo "systemd-boot" > /etc/distro-bootloader/active
            log "Active bootloader: systemd-boot"
            ;;
        *)
            error "Unknown bootloader: $target. Use 'grub' or 'systemd-boot'."
            exit 1
            ;;
    esac
}

# =============================================================================
# Show current status
# =============================================================================
show_status() {
    echo ""
    info "Bootloader Status"
    echo "  Distro:      $DISTRO_NAME"
    echo "  ESP:         $ESP_PATH"

    # Active bootloader
    local active="unknown"
    if [ -f /etc/distro-bootloader/active ]; then
        active=$(cat /etc/distro-bootloader/active)
    fi
    echo "  Bootloader:  $active"

    # Boot mode
    if [ -d /sys/firmware/efi ]; then
        echo "  Boot mode:   UEFI"
    else
        echo "  Boot mode:   BIOS (Legacy)"
    fi

    # GPU info
    detect_gpu 2>/dev/null

    # Kernel params
    build_kernel_params 2>/dev/null
    echo "  Kernel CMD:  $KERNEL_PARAMS"

    # Kernel versions
    echo "  Kernels:     $(ls /lib/modules/ 2>/dev/null | tr '\n' ' ')"

    # Snapshot support
    if command -v snapper >/dev/null 2>&1; then
        echo "  Snapshots:   snapper (active)"
    elif command -v timeshift >/dev/null 2>&1; then
        echo "  Snapshots:   timeshift (active)"
    else
        echo "  Snapshots:   none"
    fi
    echo ""
}

# =============================================================================
# Main
# =============================================================================
main() {
    local action="${1:-}"
    shift || true

    case "$action" in
        --install)
            local bootloader="${1:-grub}"
            detect_gpu
            build_kernel_params
            case "$bootloader" in
                grub|grub2)     install_grub ;;
                systemd-boot)   install_systemd_boot ;;
                *)              error "Unknown bootloader: $bootloader"; exit 1 ;;
            esac
            regenerate_initramfs
            log "Bootloader installation complete!"
            ;;
        --switch)
            switch_bootloader "${1:-grub}"
            ;;
        --regenerate)
            detect_gpu
            build_kernel_params
            regenerate_initramfs
            local active="grub2"
            if [ -f /etc/distro-bootloader/active ]; then
                active=$(cat /etc/distro-bootloader/active)
            fi
            if [ "$active" = "systemd-boot" ]; then
                generate_sd_boot_entries
            else
                regenerate_grub_config
            fi
            log "Bootloader regenerated!"
            ;;
        --detect-gpu)
            detect_gpu
            build_kernel_params
            ;;
        --status)
            show_status
            ;;
        --help|-h)
            echo "Usage: distro-bootloader-setup [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --install [grub|systemd-boot]  Install bootloader to ESP"
            echo "  --switch [grub|systemd-boot]   Switch active bootloader"
            echo "  --regenerate                   Regenerate config + initramfs"
            echo "  --detect-gpu                   Detect GPU and show kernel params"
            echo "  --status                       Show current bootloader status"
            echo "  --help                         Show this help"
            ;;
        *)
            error "Unknown action: $action"
            echo "Run 'distro-bootloader-setup --help' for usage."
            exit 1
            ;;
    esac
}

main "$@"
