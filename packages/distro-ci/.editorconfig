root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 4
shell_variant = bash

[*.{py,python}]
indent_style = space
indent_size = 4
max_line_length = 120

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{conf,cfg,ini}]
indent_style = space
indent_size = 2

[*.{ks,kickstart}]
indent_style = space
indent_size = 0

[*.xml]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
