# =============================================================================
# gaming.list — Gaming Profile Package List
# =============================================================================
# Packages installed when the user selects the "Gaming" profile during
# installation. The Calamares installer reads this file and installs
# the listed packages via DNF.
#
# Format: one package name per line, comments start with #
# =============================================================================

# ---- Game Launchers ----
# NOTE: itch and gamehub removed — not in Fedora/RPM Fusion repos.
# Install via Flathub instead:
#   flatpak install flathub io.itch.itch

steam
protonup-qt
lutris
heroic-games-launcher
bottles

