#!/usr/bin/env bash
# =============================================================================
# kaal-antivirus — user-facing antivirus control for KAAL OS
# =============================================================================
# ClamAV frontend: scan, update, and toggle on-access protection.
# Installed by the kaal-security package (script 20).
# =============================================================================

set -uo pipefail

ONACCESS_SERVICES="clamd@scan.service clamonacc.service"

usage() {
    cat << 'USAGE'
kaal-antivirus — KAAL OS antivirus control (ClamAV)

Usage:
  kaal-antivirus status               services, database age, version
  kaal-antivirus update                fetch latest signatures (freshclam)
  kaal-antivirus scan <path>           on-demand scan (daemon if running)
  kaal-antivirus enable-on-access      scan files as they are opened
  kaal-antivirus disable-on-access     stop on-access scanning

On-access is OFF by default (performance). The Security Space
enables it automatically while active.
USAGE
}

need_root() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "kaal-antivirus: this command needs sudo" >&2
        exit 1
    fi
}

svc_state() { systemctl is-active "$1" >/dev/null 2>&1 && echo "active" || echo "inactive"; }

cmd_status() {
    echo "KAAL OS antivirus (ClamAV)"
    echo "  engine:      $(clamscan --version 2>/dev/null || echo 'not installed')"
    for s in $ONACCESS_SERVICES; do
        printf '  %-28s %s\n' "$s:" "$(svc_state "$s")"
    done
    echo "  freshclam:   $(svc_state clamav-freshclam.service)"
    if [ -f /var/lib/clamav/daily.cvd ] || [ -f /var/lib/clamav/daily.cld ]; then
        echo "  signatures:  $(ls -lh /var/lib/clamav/daily.c* 2>/dev/null | awk '{print $5, $NF}')"
    else
        echo "  signatures:  none yet — run: sudo kaal-antivirus update"
    fi
}

cmd_update() {
    need_root
    systemctl start clamav-freshclam.service 2>/dev/null || true
    freshclam
}

cmd_scan() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo "kaal-antivirus: scan needs a path (e.g. kaal-antivirus scan ~/Downloads)" >&2
        exit 1
    fi
    if systemctl is-active clamd@scan.service >/dev/null 2>&1; then
        clamdscan --multiscan --fdpass "$target"
    else
        clamscan --recursive --infected "$target"
    fi
}

cmd_enable_onaccess() {
    need_root
    systemctl enable --now $ONACCESS_SERVICES
    echo "On-access scanning ENABLED (clamd + clamonacc running)."
    echo "Note: adds overhead to every file open — off again with: kaal-antivirus disable-on-access"
}

cmd_disable_onaccess() {
    need_root
    systemctl disable --now $ONACCESS_SERVICES 2>/dev/null || true
    echo "On-access scanning disabled."
}

case "${1:-help}" in
    status)              cmd_status ;;
    update)              cmd_update ;;
    scan)                shift; cmd_scan "$@" ;;
    enable-on-access)    cmd_enable_onaccess ;;
    disable-on-access)   cmd_disable_onaccess ;;
    -h|--help|help)      usage ;;
    *)                   usage; exit 1 ;;
esac
