#!/bin/bash
# KAAL OS — Space CLI Tool v2 (with custom space support)
#
# Usage:
#   kaal-space                          # Show current space
#   kaal-space list                     # List all spaces (including custom)
#   kaal-space switch <name>            # Switch to a space
#   kaal-space info <name>              # Show space details
#   kaal-space status                   # Show full status
#   kaal-space default [name]           # Get or set default space
#
#   # Custom space management:
#   kaal-space create <name> [--template <tmpl>]   # Create a new space
#   kaal-space edit <name>                          # Edit a space config
#   kaal-space clone <source> <dest>                # Clone a space
#   kaal-space delete <name>                        # Delete a custom space
#   kaal-space export <name> [file]                 # Export space as JSON
#   kaal-space import <file>                        # Import space from JSON
#   kaal-space templates                            # List available templates
#   kaal-space regenerate-targets                   # Regenerate systemd targets

set -euo pipefail

DBUS_NAME="org.kaal.Spaces"
DBUS_PATH="/org/kaal/Spaces"
STATE_FILE="/run/kaal/current-space"
DEFAULT_FILE="/var/lib/kaal/spaces/default-space"
SPACES_DIR="/etc/kaal/spaces"
TEMPLATES_DIR="/usr/share/kaal/spaces/templates"
EDITOR="${EDITOR:-nano}"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
GRAY='\033[0;90m'
NC='\033[0m'
BOLD='\033[1m'

space_color() {
    local space="$1"
    local conf="${SPACES_DIR}/${space}.conf"
    if [[ -f "$conf" ]]; then
        local color
        color=$(awk -F= '/\[space\]/{s=1} /^\[/{if(s!=2)s=0} s&&/^color/{gsub(/^[ \t]+|[ \t]+/,"",$2);print $2;exit}' "$conf")
        [[ -n "$color" ]] && echo "$color" && return
    fi
    case "$space" in
        gaming)       echo "$RED" ;;
        development)  echo "$BLUE" ;;
        power)        echo "$PURPLE" ;;
        normal)       echo "$GREEN" ;;
        *)            echo "$GRAY" ;;
    esac
}

get_conf() {
    local space="$1" section="$2" key="$3" default="${4:-}"
    local conf="${SPACES_DIR}/${space}.conf"
    [[ ! -f "$conf" ]] && { echo "$default"; return; }
    local value
    value=$(awk -F= -v sec="\\[$section\\]" -v key="$key" '
        $0 ~ sec { in_section=1; next }
        /^\[/ { in_section=0 }
        in_section && $1 ~ "^\\s*" key "\\s*$" {
            gsub(/^\s+|\s+$/, "", $2)
            print $2
            exit
        }
    ' "$conf")
    echo "${value:-$default}"
}

is_builtin() {
    case "$1" in
        gaming|development|power|normal) return 0 ;;
        *) return 1 ;;
    esac
}

dbus_call() {
    local method="$1"
    shift
    dbus-send --system --print-reply --dest="$DBUS_NAME" \
        "$DBUS_PATH" "$DBUS_NAME.$method" "$@" 2>&1
}

# ============================================================================
# Commands
# ============================================================================

cmd_current() {
    if [[ -f "$STATE_FILE" ]]; then
        cat "$STATE_FILE"
    else
        echo "unknown"
    fi
}

cmd_list() {
    local current
    current=$(cmd_current)

    echo -e "${CYAN}╔══════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}                  ${BOLD}KAAL OS — Available Spaces${NC}                    ${CYAN}║${NC}"
    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════╣${NC}"

    for conf in "$SPACES_DIR"/*.conf; do
        [[ -f "$conf" ]] || continue
        local space
        space=$(basename "$conf" .conf)
        [[ "$space" == "auto-switch" ]] && continue

        local display_name desc color marker builtin_tag
        display_name=$(get_conf "$space" space name "$space")
        desc=$(get_conf "$space" space description "")
        color=$(space_color "$space")

        if [[ "$space" == "$current" ]]; then
            marker="${GREEN}● active${NC}"
        else
            marker="${YELLOW}○ inactive${NC}"
        fi

        if is_builtin "$space"; then
            builtin_tag="${GRAY}[built-in]${NC}"
        else
            builtin_tag="${CYAN}[custom]${NC}"
        fi

        echo -e "${CYAN}║${NC} ${color}${BOLD}${display_name}${NC} ${builtin_tag} ${marker}"
        echo -e "${CYAN}║${NC}   ${GRAY}${desc:0:56}${NC}"
        echo -e "${CYAN}║${NC}   ${GRAY}governor=$(get_conf "$space" system cpu_governor) | audio_q=$(get_conf "$space" system audio_quantum) | name=$space${NC}"
        echo -e "${CYAN}║${NC}"
    done

    echo -e "${CYAN}╠══════════════════════════════════════════════════════════════╣${NC}"
    echo -e "${CYAN}║${NC} ${GRAY}Create custom spaces: kaal-space create <name> --template <tmpl>${NC}"
    echo -e "${CYAN}║${NC} ${GRAY}Available templates: kaal-space templates${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════════════════════════╝${NC}"
}

cmd_switch() {
    local target="$1"
    [[ -z "$target" ]] && { echo "Usage: kaal-space switch <name>" >&2; exit 1; }

    if [[ ! -f "${SPACES_DIR}/${target}.conf" ]]; then
        echo -e "${RED}Error: Space '${target}' does not exist${NC}" >&2
        echo "Run 'kaal-space list' to see available spaces" >&2
        exit 1
    fi

    echo -e "${YELLOW}Switching to '${target}' space...${NC}"

    # Try D-Bus
    result=$(dbus_call SwitchSpace "string:$target" 2>&1)
    if echo "$result" | grep -q "Switched to"; then
        echo -e "${GREEN}✓ Switched to ${target} space${NC}"
        return 0
    fi

    # Fallback
    if [[ $EUID -ne 0 ]]; then
        exec pkexec kaal-space switch "$target"
    fi
    /usr/libexec/kaal-spaces/apply-space.sh "$target"
    echo "$target" > "$STATE_FILE"
    echo -e "${GREEN}✓ Switched to ${target} space${NC}"
}

cmd_info() {
    local space="$1"
    [[ -z "$space" ]] && { echo "Usage: kaal-space info <name>" >&2; exit 1; }

    local conf="${SPACES_DIR}/${space}.conf"
    [[ ! -f "$conf" ]] && { echo -e "${RED}Space '${space}' not found${NC}" >&2; exit 1; }

    local current status builtin_tag
    current=$(cmd_current)
    status="inactive"
    [[ "$space" == "$current" ]] && status="ACTIVE"
    is_builtin "$space" && builtin_tag="built-in" || builtin_tag="custom"

    local display_name desc color governor quantum
    display_name=$(get_conf "$space" space name "$space")
    desc=$(get_conf "$space" space description "")
    color=$(get_conf "$space" space color "#888888")
    governor=$(get_conf "$space" system cpu_governor "n/a")
    quantum=$(get_conf "$space" system audio_quantum "n/a")

    echo -e "${CYAN}━━━ ${display_name} Space ━━━${NC}"
    echo -e "  Status:      ${GREEN}${status}${NC}"
    echo -e "  Type:        ${builtin_tag}"
    echo -e "  Description: ${desc}"
    echo -e "  Color:       ${color}"
    echo -e "  Config:      ${conf}"
    echo ""
    echo -e "${CYAN}System:${NC}"
    echo -e "  CPU Governor:    ${governor}"
    echo -e "  Audio Quantum:   ${quantum}"
    echo -e "  GPU Profile:     $(get_conf "$space" system gpu_power_profile 'auto')"
    echo -e "  Compositor:      $(get_conf "$space" system compositor_effects 'true')"
    echo -e "  Notifications:   $(get_conf "$space" system notifications 'normal')"
    echo ""
    echo -e "${CYAN}Services:${NC}"
    echo -e "  Enable:  $(get_conf "$space" services enable 'none')"
    echo -e "  Disable: $(get_conf "$space" services disable 'none')"
    echo ""
    echo -e "${CYAN}Desktop:${NC}"
    echo -e "  Pinned:  $(get_conf "$space" desktop pinned_apps 'none')"
}

cmd_status() {
    local current default
    current=$(cmd_current)
    default="none"
    [[ -f "$DEFAULT_FILE" ]] && default=$(cat "$DEFAULT_FILE")

    echo -e "${CYAN}═══ KAAL Spaces Status ═══${NC}"
    echo -e "  Current:   ${GREEN}${current}${NC}"
    echo -e "  Default:   $default"
    echo -e "  Daemon:    $(systemctl is-active kaal-spaced.service 2>/dev/null || echo 'inactive')"
    echo ""
    echo -e "${CYAN}Spaces:${NC}"
    for conf in "$SPACES_DIR"/*.conf; do
        [[ -f "$conf" ]] || continue
        local space
        space=$(basename "$conf" .conf)
        [[ "$space" == "auto-switch" ]] && continue
        local marker="  " display_name
        [[ "$space" == "$current" ]] && marker="→ "
        display_name=$(get_conf "$space" space name "$space")
        local tag=""
        is_builtin "$space" || tag=" ${CYAN}(custom)${NC}"
        echo -e "  ${marker}${display_name}${tag}"
    done
}

cmd_default() {
    local space="${1:-}"
    if [[ -z "$space" ]]; then
        [[ -f "$DEFAULT_FILE" ]] && echo "Default: $(cat "$DEFAULT_FILE")" || echo "No default set"
        return
    fi
    [[ ! -f "${SPACES_DIR}/${space}.conf" ]] && { echo -e "${RED}Space '${space}' not found${NC}" >&2; exit 1; }
    mkdir -p "$(dirname "$DEFAULT_FILE")"
    echo "$space" > "$DEFAULT_FILE"
    echo -e "${GREEN}✓ Default space set to ${space}${NC}"
}

# ============================================================================
# Custom Space Commands
# ============================================================================

cmd_templates() {
    echo -e "${CYAN}═══ Available Space Templates ═══${NC}"
    echo ""
    for tmpl in "$TEMPLATES_DIR"/*.conf; do
        [[ -f "$tmpl" ]] || continue
        local name display_name desc
        name=$(basename "$tmpl" .conf)
        display_name=$(get_conf "$name" space name "$name" 2>/dev/null || echo "$name")
        # Read from template file directly
        display_name=$(awk -F= '/\[space\]/{s=1}/^\[/{if(s!=2)s=0}s&&/^name/{gsub(/^[ \t]+|[ \t]+/,"",$2);print $2;exit}' "$tmpl")
        desc=$(awk -F= '/\[space\]/{s=1}/^\[/{if(s!=2)s=0}s&&/^description/{gsub(/^[ \t]+|[ \t]+/,"",$2);print $2;exit}' "$tmpl")
        echo -e "  ${BOLD}${name}${NC} — ${display_name}"
        echo -e "    ${GRAY}${desc}${NC}"
        echo ""
    done
    echo "Use: kaal-space create <name> --template <template_name>"
}

cmd_create() {
    local space_name="" template="blank"

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --template|-t)
                template="$2"
                shift 2
                ;;
            --help|-h)
                echo "Usage: kaal-space create <name> [--template <tmpl>]"
                echo "Templates: blank, study, media, creative, security, kiosk"
                return 0
                ;;
            *)
                space_name="$1"
                shift
                ;;
        esac
    done

    if [[ -z "$space_name" ]]; then
        echo -e "${CYAN}━━━ Create New KAAL Space ━━━${NC}"
        echo ""
        echo "Available templates:"
        for tmpl in "$TEMPLATES_DIR"/*.conf; do
            [[ -f "$tmpl" ]] || continue
            local tname
            tname=$(basename "$tmpl" .conf)
            echo "  - $tname"
        done
        echo ""
        read -rp "Space name (lowercase, letters/digits/hyphens): " space_name
        read -rp "Template [blank]: " template
        template="${template:-blank}"
    fi

    # Validate name
    if ! echo "$space_name" | grep -qE '^[a-z][a-z0-9-]{1,31}$'; then
        echo -e "${RED}Error: Invalid name. Use lowercase letters, digits, and hyphens.${NC}" >&2
        echo "Must start with a letter, be 2-32 characters." >&2
        exit 1
    fi

    if [[ -f "${SPACES_DIR}/${space_name}.conf" ]]; then
        echo -e "${RED}Error: Space '${space_name}' already exists${NC}" >&2
        exit 1
    fi

    # Try D-Bus
    result=$(dbus_call CreateSpace "string:$space_name" "string:$template" 2>&1)
    if echo "$result" | grep -q "Created"; then
        echo -e "${GREEN}✓ Created space '${space_name}' from template '${template}'${NC}"
        echo ""
        echo "Edit it: kaal-space edit ${space_name}"
        echo "Switch to it: kaal-space switch ${space_name}"
        return 0
    fi

    # Fallback: create directly
    if [[ $EUID -ne 0 ]]; then
        exec pkexec kaal-space create "$space_name" --template "$template"
    fi

    local template_path="${TEMPLATES_DIR}/${template}.conf"
    [[ ! -f "$template_path" ]] && template_path="${TEMPLATES_DIR}/blank.conf"
    [[ ! -f "$template_path" ]] && { echo -e "${RED}No templates found${NC}" >&2; exit 1; }

    cp "$template_path" "${SPACES_DIR}/${space_name}.conf"
    /usr/libexec/kaal-spaces/generate-targets.sh >/dev/null 2>&1 || true
    echo -e "${GREEN}✓ Created space '${space_name}'${NC}"
    echo "Edit it: kaal-space edit ${space_name}"
}

cmd_edit() {
    local space="$1"
    [[ -z "$space" ]] && { echo "Usage: kaal-space edit <name>" >&2; exit 1; }
    local conf="${SPACES_DIR}/${space}.conf"
    [[ ! -f "$conf" ]] && { echo -e "${RED}Space '${space}' not found${NC}" >&2; exit 1; }

    if is_builtin "$space"; then
        echo -e "${YELLOW}Note: '${space}' is a built-in space. Edits will override defaults.${NC}"
        read -rp "Continue? [y/N] " confirm
        [[ "$confirm" =~ ^[Yy] ]] || return 0
    fi

    "$EDITOR" "$conf"

    # Regenerate targets after edit
    if [[ $EUID -eq 0 ]]; then
        /usr/libexec/kaal-spaces/generate-targets.sh >/dev/null 2>&1 || true
    fi
    echo -e "${GREEN}✓ Space '${space}' updated${NC}"
}

cmd_clone() {
    local source="$1" dest="$2"
    [[ -z "$source" || -z "$dest" ]] && { echo "Usage: kaal-space clone <source> <dest>" >&2; exit 1; }

    result=$(dbus_call CloneSpace "string:$source" "string:$dest" 2>&1)
    if echo "$result" | grep -q "Cloned"; then
        echo -e "${GREEN}✓ Cloned '${source}' to '${dest}'${NC}"
        echo "Edit it: kaal-space edit ${dest}"
    else
        echo -e "${RED}Clone failed: $result${NC}" >&2
        exit 1
    fi
}

cmd_delete() {
    local space="$1"
    [[ -z "$space" ]] && { echo "Usage: kaal-space delete <name>" >&2; exit 1; }

    if is_builtin "$space"; then
        echo -e "${RED}Error: Cannot delete built-in space '${space}'${NC}" >&2
        exit 1
    fi

    [[ ! -f "${SPACES_DIR}/${space}.conf" ]] && { echo -e "${RED}Space '${space}' not found${NC}" >&2; exit 1; }

    echo -e "${YELLOW}Delete custom space '${space}'? This cannot be undone.${NC}"
    read -rp "Type the space name to confirm: " confirm
    [[ "$confirm" == "$space" ]] || { echo "Cancelled."; exit 0; }

    result=$(dbus_call DeleteSpace "string:$space" 2>&1)
    if echo "$result" | grep -q "Deleted"; then
        echo -e "${GREEN}✓ Deleted space '${space}'${NC}"
    else
        echo -e "${RED}Delete failed: $result${NC}" >&2
        exit 1
    fi
}

cmd_export() {
    local space="$1" file="${2:-}"
    [[ -z "$space" ]] && { echo "Usage: kaal-space export <name> [file]" >&2; exit 1; }

    result=$(dbus_call ExportSpace "string:$space" 2>&1)
    # Extract the JSON from dbus-send output
    local json
    json=$(echo "$result" | sed -n '/string "/{s/.*string "//;s/"$//;p}')

    if [[ -n "$file" ]]; then
        echo "$json" > "$file"
        echo -e "${GREEN}✓ Exported '${space}' to ${file}${NC}"
    else
        echo "$json"
    fi
}

cmd_import() {
    local file="$1"
    [[ -z "$file" ]] && { echo "Usage: kaal-space import <file>" >&2; exit 1; }
    [[ ! -f "$file" ]] && { echo -e "${RED}File not found: ${file}${NC}" >&2; exit 1; }

    local json
    json=$(cat "$file")

    result=$(dbus_call ImportSpace "string:$json" 2>&1)
    if echo "$result" | grep -q "Imported"; then
        echo -e "${GREEN}✓ Imported space from ${file}${NC}"
    else
        echo -e "${RED}Import failed: $result${NC}" >&2
        exit 1
    fi
}

cmd_regenerate() {
    if [[ $EUID -ne 0 ]]; then
        exec pkexec kaal-space regenerate-targets
    fi
    /usr/libexec/kaal-spaces/generate-targets.sh
    echo -e "${GREEN}✓ Systemd targets regenerated${NC}"
}

# ============================================================================
# Main
# ============================================================================
main() {
    local cmd="${1:-current}"
    shift || true

    case "$cmd" in
        current)        cmd_current ;;
        list|ls)        cmd_list ;;
        switch|sw)      cmd_switch "$1" ;;
        info|i)         cmd_info "$1" ;;
        status|st)      cmd_status ;;
        default|def)    cmd_default "$1" ;;
        create|new)     cmd_create "$@" ;;
        edit)           cmd_edit "$1" ;;
        clone|copy)     cmd_clone "$1" "$2" ;;
        delete|rm)      cmd_delete "$1" ;;
        export)         cmd_export "$1" "$2" ;;
        import)         cmd_import "$1" ;;
        templates|tmpl) cmd_templates ;;
        regenerate-targets|regen) cmd_regenerate ;;
        help|-h|--help)
            echo "KAAL OS Space Manager v2"
            echo ""
            echo "Usage: kaal-space <command> [args]"
            echo ""
            echo "Built-in Commands:"
            echo "  current              Show current space"
            echo "  list                  List all spaces (including custom)"
            echo "  switch <name>        Switch to a space"
            echo "  info <name>           Show space details"
            echo "  status                Show full status"
            echo "  default [name]       Get/set default space"
            echo ""
            echo "Custom Space Commands:"
            echo "  create <name> [--template <t>]   Create a new space"
            echo "  edit <name>                      Edit a space config"
            echo "  clone <source> <dest>            Clone a space"
            echo "  delete <name>                    Delete a custom space"
            echo "  export <name> [file]             Export space as JSON"
            echo "  import <file>                    Import space from JSON"
            echo "  templates                        List available templates"
            echo "  regenerate-targets               Regenerate systemd targets"
            echo ""
            echo "Built-in Spaces: gaming, development, power, normal"
            echo "Templates: blank, study, media, creative, security, kiosk"
            ;;
        *)
            echo -e "${RED}Unknown command: $cmd${NC}" >&2
            echo "Run 'kaal-space help' for usage" >&2
            exit 1
            ;;
    esac
}

main "$@"
