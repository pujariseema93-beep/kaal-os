#!/usr/bin/env python3
"""
KAAL OS Space Switcher v2 — Qt6 GUI Application

Dynamically discovers all spaces (built-in + custom) from /etc/kaal/spaces/*.conf
and displays them as clickable cards. Supports space creation via the editor.

Run: kaal-space-switcher
"""

import sys
import os
import glob
import configparser
import subprocess

from PyQt6.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QLabel, QPushButton, QFrame, QScrollArea, QGridLayout
)
from PyQt6.QtCore import Qt, QTimer
from PyQt6.QtGui import QFont, QColor, QPalette

try:
    import dbus
    DBUS_AVAILABLE = True
except ImportError:
    DBUS_AVAILABLE = False

DBUS_NAME = "org.kaal.Spaces"
DBUS_PATH = "/org/kaal/Spaces"
SPACES_DIR = "/etc/kaal/spaces"
STATE_FILE = "/run/kaal/current-space"

# Fallback metadata for built-in spaces
BUILTIN_META = {
    "gaming": {"icon": "🎮", "color": "#FF6B35"},
    "development": {"icon": "💻", "color": "#4A90D9"},
    "power": {"icon": "⚡", "color": "#9B59B6"},
    "normal": {"icon": "🏠", "color": "#2ECC71"},
}

# Default icons for templates
TEMPLATE_ICONS = {
    "study": "📚", "media": "🎬", "creative": "🎨",
    "security": "🔒", "kiosk": "🖥️", "blank": "✨",
}


def discover_spaces():
    """Dynamically discover all spaces from config files."""
    spaces = []
    for conf_path in sorted(glob.glob(os.path.join(SPACES_DIR, "*.conf"))):
        basename = os.path.basename(conf_path)
        if basename == "auto-switch.conf":
            continue
        space_name = basename.replace(".conf", "")

        config = configparser.ConfigParser()
        config.read(conf_path)

        display_name = config.get("space", "name", fallback=space_name.title())
        description = config.get("space", "description", fallback="")
        color = config.get("space", "color", fallback="#888888")

        # Pick icon
        if space_name in BUILTIN_META:
            icon = BUILTIN_META[space_name]["icon"]
        else:
            icon = "✨"  # Custom space default

        is_builtin = space_name in BUILTIN_META

        spaces.append({
            "name": space_name,
            "display_name": display_name,
            "description": description,
            "color": color,
            "icon": icon,
            "builtin": is_builtin,
        })
    return spaces


def get_current_space():
    if DBUS_AVAILABLE:
        try:
            bus = dbus.SystemBus()
            proxy = bus.get_object(DBUS_NAME, DBUS_PATH)
            iface = dbus.Interface(proxy, DBUS_NAME)
            return str(iface.GetCurrentSpace())
        except Exception:
            pass
    try:
        with open(STATE_FILE, "r") as f:
            return f.read().strip()
    except FileNotFoundError:
        return "normal"


class SpaceCard(QFrame):
    """A clickable card representing a single space."""

    clicked = __import__('PyQt6.QtCore', fromlist=['pyqtSignal']).pyqtSignal(str)

    def __init__(self, space_info, is_active=False):
        super().__init__()
        self.space_name = space_info["name"]
        self.space_info = space_info
        self.is_active = is_active

        self.setFrameShape(QFrame.Shape.Box)
        self.setFixedHeight(200)
        self.setMinimumWidth(260)
        self.setMaximumWidth(300)
        self.setCursor(Qt.CursorShape.PointingHandCursor)
        self._update_style()

        layout = QVBoxLayout(self)
        layout.setContentsMargins(16, 16, 16, 16)
        layout.setSpacing(6)

        # Icon
        icon_label = QLabel(space_info["icon"])
        icon_label.setFont(QFont("Sans", 32))
        icon_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(icon_label)

        # Title
        title_label = QLabel(space_info["display_name"])
        title_label.setFont(QFont("Sans", 14, QFont.Weight.Bold))
        title_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(title_label)

        # Description (truncated)
        desc = space_info["description"][:60]
        desc_label = QLabel(desc)
        desc_label.setFont(QFont("Sans", 9))
        desc_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        desc_label.setWordWrap(True)
        desc_label.setStyleSheet("color: #888;")
        layout.addWidget(desc_label)

        # Tags
        tag_text = ""
        if is_active:
            tag_text = "● ACTIVE"
            tag_color = "#2ECC71"
        elif not space_info["builtin"]:
            tag_text = "◇ custom"
            tag_color = "#4A90D9"
        if tag_text:
            tag_label = QLabel(tag_text)
            tag_label.setFont(QFont("Sans", 8, QFont.Weight.Bold))
            tag_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
            tag_label.setStyleSheet(f"color: {tag_color};")
            layout.addWidget(tag_label)

    def _update_style(self):
        color = self.space_info.get("color", "#888888")
        # Parse hex color to RGB
        try:
            r = int(color[1:3], 16)
            g = int(color[3:5], 16)
            b = int(color[5:7], 16)
        except (ValueError, IndexError):
            r, g, b = 136, 136, 136

        if self.is_active:
            self.setStyleSheet(f"""
                SpaceCard {{
                    border: 3px solid {color};
                    border-radius: 12px;
                    background-color: rgba({r}, {g}, {b}, 30);
                }}
            """)
        else:
            self.setStyleSheet(f"""
                SpaceCard {{
                    border: 2px solid #333;
                    border-radius: 12px;
                    background-color: #1a1a1a;
                }}
                SpaceCard:hover {{
                    border: 2px solid {color};
                    background-color: rgba({r}, {g}, {b}, 15);
                }}
            """)

    def set_active(self, active):
        self.is_active = active
        self._update_style()
        self.update()

    def mousePressEvent(self, event):
        if event.button() == Qt.MouseButton.LeftButton:
            self.clicked.emit(self.space_name)
        super().mousePressEvent(event)


class SpaceSwitcher(QMainWindow):
    """Main window — dynamically displays all spaces."""

    def __init__(self):
        super().__init__()
        self.setWindowTitle("KAAL Spaces")
        self.setMinimumSize(1000, 500)
        self.setStyleSheet("background-color: #0d0d0d;")

        central = QWidget()
        self.setCentralWidget(central)
        self.main_layout = QVBoxLayout(central)
        self.main_layout.setContentsMargins(20, 20, 20, 20)
        self.main_layout.setSpacing(12)

        self._build_header()
        self._build_cards_container()
        self._build_footer()

        self.cards = {}
        self._refresh_cards()

        # Auto-refresh
        self.timer = QTimer(self)
        self.timer.timeout.connect(self._refresh_cards)
        self.timer.start(3000)

    def _build_header(self):
        header = QLabel("KAAL Spaces")
        header.setFont(QFont("Sans", 22, QFont.Weight.Bold))
        header.setStyleSheet("color: #ffffff;")
        self.main_layout.addWidget(header)

        self.subtitle = QLabel("Click a space to switch. Your system adapts instantly.")
        self.subtitle.setFont(QFont("Sans", 11))
        self.subtitle.setStyleSheet("color: #888;")
        self.main_layout.addWidget(self.subtitle)

    def _build_cards_container(self):
        """Create a scrollable area for space cards."""
        self.scroll = QScrollArea()
        self.scroll.setWidgetResizable(True)
        self.scroll.setStyleSheet("QScrollArea { border: none; background: transparent; }")

        self.cards_widget = QWidget()
        self.cards_widget.setStyleSheet("background: transparent;")
        self.cards_layout = QHBoxLayout(self.cards_widget)
        self.cards_layout.setSpacing(12)
        self.cards_layout.setContentsMargins(0, 10, 0, 10)

        self.scroll.setWidget(self.cards_widget)
        self.main_layout.addWidget(self.scroll)

    def _build_footer(self):
        footer = QHBoxLayout()

        self.status_label = QLabel("Loading...")
        self.status_label.setFont(QFont("Sans", 10))
        self.status_label.setStyleSheet("color: #666;")
        footer.addWidget(self.status_label)

        footer.addStretch()

        # Create new space button
        create_btn = QPushButton("+ Create Space")
        create_btn.setStyleSheet("""
            QPushButton {
                background-color: #4A90D9; border: none;
                border-radius: 6px; padding: 8px 16px;
                color: white; font-weight: bold;
            }
            QPushButton:hover { background-color: #5AA0E9; }
        """)
        create_btn.clicked.connect(self._open_editor)
        footer.addWidget(create_btn)

        # Refresh button
        refresh_btn = QPushButton("↻ Refresh")
        refresh_btn.setStyleSheet("""
            QPushButton {
                background-color: #2a2a2a; border: 1px solid #555;
                border-radius: 6px; padding: 8px 16px; color: #fff;
            }
            QPushButton:hover { background-color: #3a3a3a; }
        """)
        refresh_btn.clicked.connect(self._refresh_cards)
        footer.addWidget(refresh_btn)

        self.main_layout.addLayout(footer)

    def _refresh_cards(self):
        """Rebuild space cards from current config files."""
        spaces = discover_spaces()
        current = get_current_space()

        # Clear existing cards
        while self.cards_layout.count():
            item = self.cards_layout.takeAt(0)
            if item.widget():
                item.widget().deleteLater()

        self.cards = {}

        for space_info in spaces:
            is_active = (space_info["name"] == current)
            card = SpaceCard(space_info, is_active)
            card.clicked.connect(self._on_space_clicked)
            self.cards[space_info["name"]] = card
            self.cards_layout.addWidget(card)

        # Add a "create new" card
        create_card = QFrame()
        create_card.setFixedHeight(200)
        create_card.setMinimumWidth(200)
        create_card.setMaximumWidth(260)
        create_card.setCursor(Qt.CursorShape.PointingHandCursor)
        create_card.setStyleSheet("""
            QFrame {
                border: 2px dashed #444;
                border-radius: 12px;
                background-color: #111;
            }
            QFrame:hover {
                border: 2px dashed #4A90D9;
                background-color: rgba(74, 144, 217, 10);
            }
        """)
        create_layout = QVBoxLayout(create_card)
        create_layout.setContentsMargins(16, 16, 16, 16)
        plus_label = QLabel("＋")
        plus_label.setFont(QFont("Sans", 32))
        plus_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        plus_label.setStyleSheet("color: #555;")
        create_layout.addWidget(plus_label)

        new_label = QLabel("New Space")
        new_label.setFont(QFont("Sans", 12))
        new_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        new_label.setStyleSheet("color: #555;")
        create_layout.addWidget(new_label)

        tmpl_label = QLabel("from template")
        tmpl_label.setFont(QFont("Sans", 9))
        tmpl_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        tmpl_label.setStyleSheet("color: #444;")
        create_layout.addWidget(tmpl_label)

        def open_editor(e):
            self._open_editor()
        create_card.mousePressEvent = open_editor

        self.cards_layout.addWidget(create_card)
        self.cards_layout.addStretch()

        # Update status
        space_names = {"gaming": "Gaming", "development": "Development",
                       "power": "Power User", "normal": "Normal"}
        display = space_names.get(current, current.title())
        self.status_label.setText(f"Current space: {display}  |  {len(spaces)} spaces available")

    def _on_space_clicked(self, space_name):
        if space_name == get_current_space():
            return

        self.status_label.setText(f"Switching to {space_name}...")

        if DBUS_AVAILABLE:
            try:
                bus = dbus.SystemBus()
                proxy = bus.get_object(DBUS_NAME, DBUS_PATH)
                iface = dbus.Interface(proxy, DBUS_NAME)
                result = str(iface.SwitchSpace(space_name))
                self.status_label.setText(result)
                self._refresh_cards()
                return
            except dbus.exceptions.DBusException as e:
                if "Permission" in str(e) or "NotAuthorized" in str(e):
                    self._switch_with_pkexec(space_name)
                    return
                self.status_label.setText(f"D-Bus error: {e}")
                return

        self._switch_with_pkexec(space_name)

    def _switch_with_pkexec(self, space_name):
        try:
            result = subprocess.run(
                ["pkexec", "kaal-space", "switch", space_name],
                capture_output=True, text=True, timeout=30
            )
            if result.returncode == 0:
                self.status_label.setText(f"Switched to {space_name} space")
                self._refresh_cards()
            else:
                self.status_label.setText(f"Switch failed: {result.stderr.strip()}")
        except subprocess.TimeoutExpired:
            self.status_label.setText("Switch timed out")
        except FileNotFoundError:
            self.status_label.setText("pkexec not available")

    def _open_editor(self):
        """Launch the space editor."""
        try:
            subprocess.Popen(["kaal-space-editor"], start_new_session=True)
        except FileNotFoundError:
            self.status_label.setText("Space editor not installed")


def main():
    app = QApplication(sys.argv)
    app.setApplicationName("KAAL Space Switcher")

    palette = QPalette()
    palette.setColor(QPalette.ColorRole.Window, QColor("#0d0d0d"))
    palette.setColor(QPalette.ColorRole.WindowText, QColor("#ffffff"))
    app.setPalette(palette)

    window = SpaceSwitcher()
    window.show()

    sys.exit(app.exec())


if __name__ == "__main__":
    main()
