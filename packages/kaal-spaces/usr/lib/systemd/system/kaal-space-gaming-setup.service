[Unit]
Description=KAAL OS Gaming Space Setup
After=kaal-spaced.service
Before=graphical-session.target

# This is a one-shot service that applies the space configuration
[Service]
Type=oneshot
ExecStart=/usr/libexec/kaal-spaces/apply-space.sh gaming
RemainAfterExit=yes

[Install]
WantedBy=kaal-space-gaming.target
