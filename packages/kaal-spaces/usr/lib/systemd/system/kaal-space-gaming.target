[Unit]
Description=KAAL OS Gaming Space Target
Description=Gaming Space — performance mode, game launchers, low-latency audio
AllowIsolate=yes

# Only one space target can be active at a time
Conflicts=kaal-space-development.target kaal-space-power.target kaal-space-normal.target

# Pull in the space setup service
Wants=kaal-space-gaming-setup.service
After=kaal-spaced.service

[Install]
WantedBy=multi-user.target
