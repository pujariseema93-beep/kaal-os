[Unit]
Description=KAAL OS Normal Space Target
Description=Normal Space — clean desktop, daily apps, power saving
AllowIsolate=yes

# Only one space target can be active at a time
Conflicts=kaal-space-gaming.target kaal-space-development.target kaal-space-power.target

# Pull in the space setup service
Wants=kaal-space-normal-setup.service
After=kaal-spaced.service

[Install]
WantedBy=multi-user.target
