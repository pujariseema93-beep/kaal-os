[Unit]
Description=KAAL OS Power Space Target
Description=Power User Space — full system access, all tools, verbose
AllowIsolate=yes

# Only one space target can be active at a time
Conflicts=kaal-space-gaming.target kaal-space-development.target kaal-space-normal.target

# Pull in the space setup service
Wants=kaal-space-power-setup.service
After=kaal-spaced.service

[Install]
WantedBy=multi-user.target
