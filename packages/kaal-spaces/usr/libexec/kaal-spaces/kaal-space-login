#!/bin/bash
# KAAL OS — Login Space Selector
# Called by greetd/display manager to present a space selection before login.
# Can also be used as a PAM exec module.

SPACES_DIR="/etc/kaal/spaces"
DEFAULT_FILE="/var/lib/kaal/spaces/default-space"
STATE_FILE="/run/kaal/current-space"

# Space display info
declare -A SPACE_NAMES=(
    [gaming]="Gaming"
    [development]="Development"
    [power]="Power User"
    [normal]="Normal"
)

declare -A SPACE_DESC=(
    [gaming]="Performance mode for gaming"
    [development]="Development environment"
    [power]="Full system control"
    [normal]="Everyday computing"
)

declare -A SPACE_COLORS=(
    [gaming]="\033[0;31m"   # Red
    [development]="\033[0;34m" # Blue
    [power]="\033[0;35m"      # Purple
    [normal]="\033[0;32m"     # Green
)

NC="\033[0m"

# Get default space
get_default() {
    if [[ -f "$DEFAULT_FILE" ]]; then
        cat "$DEFAULT_FILE"
    else
        echo "normal"
    fi
}

# Show space selection menu (text mode for login screen)
show_menu() {
    local default
    default=$(get_default)

    echo ""
    echo -e "\033[1m╔══════════════════════════════════════════╗${NC}"
    echo -e "\033[1m║          KAAL OS — Select Space          ║${NC}"
    echo -e "\033[1m╠══════════════════════════════════════════╣${NC}"
    echo -e "\033[1m║${NC}  Choose your space for this session:      ${NC}"
    echo -e "\033[1m║${NC}                                          ${NC}"

    local i=1
    for space in gaming development power normal; do
        local marker="  "
        [[ "$space" == "$default" ]] && marker="→ "
        echo -e "\033[1m║${NC}  ${SPACE_COLORS[$space]}$i) ${SPACE_NAMES[$space]}${NC}"
        echo -e "\033[1m║${NC}     ${SPACE_DESC[$space]}${NC}"
        echo -e "\033[1m║${NC}                                          ${NC}"
        ((i++))
    done

    echo -e "\033[1m║${NC}  Enter for default ($(get_default))        ${NC}"
    echo -e "\033[1m╚══════════════════════════════════════════╝${NC}"
    echo ""
    echo -n "Select [1-4]: "
}

# Parse selection
parse_selection() {
    local choice="$1"
    case "$choice" in
        1) echo "gaming" ;;
        2) echo "development" ;;
        3) echo "power" ;;
        4) echo "normal" ;;
        "") get_default ;;
        *) echo "invalid" ;;
    esac
}

# Apply space selection before session starts
apply_login_space() {
    local space="$1"

    if [[ ! -f "${SPACES_DIR}/${space}.conf" ]]; then
        echo "Invalid space: $space" >&2
        return 1
    fi

    # Write to state file so the session starts with the right space
    mkdir -p "$(dirname "$STATE_FILE")"
    echo "$space" > "$STATE_FILE"

    # Persist as last space
    mkdir -p "$(dirname "$DEFAULT_FILE")"
    echo "$space" > "$DEFAULT_FILE"

    # Trigger the space setup
    if [[ -x /usr/libexec/kaal-spaces/apply-space.sh ]]; then
        /usr/libexec/kaal-spaces/apply-space.sh "$space" 2>/dev/null || true
    fi

    return 0
}

# Main
main() {
    if [[ "${1:-}" == "--apply" ]]; then
        # Called with a specific space (from display manager)
        apply_login_space "${2:-normal}"
        exit $?
    fi

    if [[ "${1:-}" == "--get-default" ]]; then
        get_default
        exit 0
    fi

    # Interactive mode
    show_menu
    read -r choice

    local space
    space=$(parse_selection "$choice")

    if [[ "$space" == "invalid" ]]; then
        echo "Invalid selection"
        exit 1
    fi

    echo -e "Activating ${SPACE_COLORS[$space]}${SPACE_NAMES[$space]}${NC} space..."
    apply_login_space "$space"
    echo "Ready. Starting your session."
}

main "$@"
